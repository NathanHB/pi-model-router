{
	"enabled": true,
	"cheap": [
		{ "provider": "anthropic", "model": "claude-haiku-4-5", "thinkingLevel": "off" }
	],
	"capable": [
		{ "provider": "anthropic", "model": "claude-sonnet-5", "thinkingLevel": "high" }
	],
	"escalation": {
		"mode": "both",
		"tool": {
			"promptHint": true
		},
		"encoder": {
			"enabled": true,
			"url": "http://127.0.0.1:9731",
			"apiKey": "$LAYA_API_KEY",
			"timeoutMs": 2000,
			"threshold": 0.75,
			"minConfidence": 0.4,
			"checkEvery": 1,
			"maxChecks": 8,
			"instructions": "The agent currently working on this task with a cheap model will fail to complete it."
		},
		"stickyCapableRequests": 0
	},
	"imagesForceCapable": true,
	"bigPrefix": "!big",
	"smallPrefix": "!small",
	"notify": true
}
